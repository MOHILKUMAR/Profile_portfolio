# Copy to .env for local development. Never commit .env.
# In production these are set on the Worker, not in this file. See README.

# Supabase project settings > Data API (URL) and API Keys (anon / publishable key).
# The anon key is safe in a browser: row level security is what protects the data.
PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Canonical origin, no trailing slash. Used for canonical tags, hreflang and the
# magic link redirect. Must match a URL allow-listed in Supabase auth settings.
PUBLIC_SITE_URL="http://localhost:4321"

# Social preview image, used for og:image. An absolute URL, or a path such as
# /og.png for a file in public/. Leave blank to omit the tag. Project pages
# prefer their own photo and fall back to this.
PUBLIC_OG_IMAGE=""

# Shown on the site. Leave any of these blank to hide that link.
PUBLIC_CONTACT_EMAIL="you@example.com"
PUBLIC_GITHUB_URL="https://github.com/your-handle"
PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/your-handle"
