---
import Base from '../layouts/Base.astro';
import { localeFromPath, localizePath, useTranslations } from '../i18n/utils';

// A 404 can be served for any URL, so the locale comes from the path itself.
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<Base locale={locale} title={t('notFound.title')}>
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-fg sm:text-4xl">{t('notFound.title')}</h1>
    <p class="mt-3 text-muted">{t('notFound.body')}</p>
    <a
      href={localizePath('/', locale)}
      class="mt-8 inline-block rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-fg transition-colors hover:bg-accent-hover"
    >
      {t('notFound.cta')}
    </a>
  </div>
</Base>
