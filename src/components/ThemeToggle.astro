---
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const modes = [
  { value: 'system', label: t('theme.system') },
  { value: 'light', label: t('theme.light') },
  { value: 'dark', label: t('theme.dark') },
] as const;
---

<div
  role="group"
  aria-label={t('theme.label')}
  class="flex items-center gap-0.5 rounded-md border border-line p-0.5"
  data-theme-toggle
>
  {
    modes.map((mode) => (
      <button
        type="button"
        data-theme-option={mode.value}
        aria-label={mode.label}
        title={mode.label}
        aria-pressed="false"
        class="flex h-7 w-7 items-center justify-center rounded text-muted transition-colors hover:text-fg aria-pressed:bg-accent aria-pressed:text-accent-fg"
      >
        {mode.value === 'system' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4" aria-hidden="true">
            <rect x="3" y="4" width="18" height="12" rx="1.5" />
            <path stroke-linecap="round" d="M8 20h8M12 16v4" />
          </svg>
        )}
        {mode.value === 'light' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path stroke-linecap="round" d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
          </svg>
        )}
        {mode.value === 'dark' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />
          </svg>
        )}
      </button>
    ))
  }
</div>

<script>
  type Mode = 'system' | 'light' | 'dark';

  const read = (): Mode => {
    try {
      const stored = localStorage.getItem('theme');
      return stored === 'light' || stored === 'dark' ? stored : 'system';
    } catch {
      return 'system';
    }
  };

  const apply = (mode: Mode) => {
    // "system" simply removes the override and lets prefers-color-scheme win.
    if (mode === 'system') {
      document.documentElement.removeAttribute('data-theme');
    } else {
      document.documentElement.setAttribute('data-theme', mode);
    }

    document.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeOption === mode));
    });
  };

  const setMode = (mode: Mode) => {
    try {
      if (mode === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch {
      /* Storage blocked, the change still applies for this page view. */
    }
    apply(mode);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach((button) => {
    button.addEventListener('click', () => setMode(button.dataset.themeOption as Mode));
  });

  apply(read());
</script>
