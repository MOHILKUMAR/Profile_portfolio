---
import type { Project } from '../lib/projects';

interface Props {
  project?: Project | null;
  action: string;
  submitLabel: string;
  error?: string | null;
}

const { project = null, action, submitLabel, error = null } = Astro.props;

const translations = project?.translations ?? {};
const hi = translations.hi ?? {};
const es = translations.es ?? {};

const inputClass =
  'mt-1.5 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-fg placeholder:text-muted focus:border-accent focus:outline-none';
const labelClass = 'block text-sm font-medium text-fg';
const hintClass = 'mt-1 text-xs text-muted';
---

<form method="post" action={action} enctype="multipart/form-data" class="space-y-8">
  {
    error && (
      <p role="alert" class="rounded-lg border border-negative bg-surface px-4 py-3 text-sm text-negative">
        {error}
      </p>
    )
  }

  <fieldset class="space-y-5">
    <legend class="text-sm font-semibold uppercase tracking-wide text-muted">Project</legend>

    <div>
      <label for="title" class={labelClass}>Title <span class="text-negative">*</span></label>
      <input id="title" name="title" type="text" required value={project?.title ?? ''} class={inputClass} />
    </div>

    <div>
      <label for="slug" class={labelClass}>Page address</label>
      <div
        class="mt-1.5 flex items-center rounded-lg border border-line bg-surface text-sm focus-within:border-accent"
      >
        <span class="select-none pl-3 text-muted" aria-hidden="true">/projects/</span>
        <input
          id="slug"
          name="slug"
          type="text"
          value={project?.slug ?? ''}
          placeholder="msg"
          aria-describedby="slug-hint"
          class="w-full rounded-lg bg-transparent py-2 pr-3 text-fg placeholder:text-muted focus:outline-none"
        />
      </div>
      <p id="slug-hint" class={hintClass}>
        The short name in this portfolio's own address. Not the live site link, that goes below. Leave blank
        to make one from the title.
      </p>
    </div>

    <div>
      <label for="summary" class={labelClass}>Short description</label>
      <textarea id="summary" name="summary" rows="2" class={inputClass}>{project?.summary ?? ''}</textarea>
      <p class={hintClass}>One or two lines. Shown on the project cards and in search results.</p>
    </div>

    <div>
      <label for="description" class={labelClass}>Full description</label>
      <textarea id="description" name="description" rows="8" class={inputClass}>{project?.description ?? ''}</textarea>
      <p class={hintClass}>Plain text. Leave a blank line between paragraphs.</p>
    </div>
  </fieldset>

  <fieldset class="space-y-5">
    <legend class="text-sm font-semibold uppercase tracking-wide text-muted">Links and tech</legend>

    <div>
      <label for="host_url" class={labelClass}>Live site URL</label>
      <input
        id="host_url"
        name="host_url"
        type="text"
        inputmode="url"
        value={project?.host_url ?? ''}
        placeholder="example.com"
        class={inputClass}
      />
      <p class={hintClass}>Where the project is hosted. https:// is added if you leave it off.</p>
    </div>

    <div>
      <label for="repo_url" class={labelClass}>Source code URL</label>
      <input
        id="repo_url"
        name="repo_url"
        type="text"
        inputmode="url"
        value={project?.repo_url ?? ''}
        placeholder="github.com/you/project"
        class={inputClass}
      />
    </div>

    <div>
      <label for="tech" class={labelClass}>Tech used</label>
      <input
        id="tech"
        name="tech"
        type="text"
        value={project?.tech?.join(', ') ?? ''}
        placeholder="Astro, TypeScript, Postgres"
        class={inputClass}
      />
      <p class={hintClass}>Comma separated.</p>
    </div>
  </fieldset>

  <fieldset class="space-y-5">
    <legend class="text-sm font-semibold uppercase tracking-wide text-muted">Project photo</legend>

    {
      project?.image_url && (
        <div class="flex items-start gap-4">
          <img
            src={project.image_url}
            alt=""
            width="160"
            height="100"
            class="h-24 w-40 rounded-lg border border-line object-cover"
          />
          <label class="flex items-center gap-2 text-sm text-fg">
            <input type="checkbox" name="remove_image" class="h-4 w-4 accent-[var(--c-accent)]" />
            Remove this photo
          </label>
        </div>
      )
    }

    <div>
      <label for="image" class={labelClass}>
        {project?.image_url ? 'Replace photo' : 'Upload photo'}
      </label>
      <input
        id="image"
        name="image"
        type="file"
        accept="image/png,image/jpeg,image/webp,image/avif,image/gif"
        class="mt-1.5 w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-fg file:mr-3 file:rounded-md file:border-0 file:bg-surface-2 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-fg"
      />
      <p class={hintClass}>PNG, JPEG, WebP, AVIF or GIF. Up to 5 MB. A 16:10 crop looks best.</p>
    </div>
  </fieldset>

  <fieldset class="space-y-5">
    <legend class="text-sm font-semibold uppercase tracking-wide text-muted">Translations</legend>
    <p class="text-sm text-muted">
      Optional. Anything left blank falls back to the English text above.
    </p>

    <details class="rounded-lg border border-line bg-surface p-4" open={Boolean(hi.title || hi.summary)}>
      <summary class="cursor-pointer text-sm font-medium text-fg">हिन्दी (Hindi)</summary>
      <div class="mt-4 space-y-4">
        <div>
          <label for="hi_title" class={labelClass}>Title</label>
          <input id="hi_title" name="hi_title" type="text" value={hi.title ?? ''} class={inputClass} lang="hi" />
        </div>
        <div>
          <label for="hi_summary" class={labelClass}>Short description</label>
          <textarea id="hi_summary" name="hi_summary" rows="2" class={inputClass} lang="hi">{hi.summary ?? ''}</textarea>
        </div>
        <div>
          <label for="hi_description" class={labelClass}>Full description</label>
          <textarea id="hi_description" name="hi_description" rows="5" class={inputClass} lang="hi">{hi.description ?? ''}</textarea>
        </div>
      </div>
    </details>

    <details class="rounded-lg border border-line bg-surface p-4" open={Boolean(es.title || es.summary)}>
      <summary class="cursor-pointer text-sm font-medium text-fg">Español (Spanish)</summary>
      <div class="mt-4 space-y-4">
        <div>
          <label for="es_title" class={labelClass}>Title</label>
          <input id="es_title" name="es_title" type="text" value={es.title ?? ''} class={inputClass} lang="es" />
        </div>
        <div>
          <label for="es_summary" class={labelClass}>Short description</label>
          <textarea id="es_summary" name="es_summary" rows="2" class={inputClass} lang="es">{es.summary ?? ''}</textarea>
        </div>
        <div>
          <label for="es_description" class={labelClass}>Full description</label>
          <textarea id="es_description" name="es_description" rows="5" class={inputClass} lang="es">{es.description ?? ''}</textarea>
        </div>
      </div>
    </details>
  </fieldset>

  <fieldset class="space-y-5">
    <legend class="text-sm font-semibold uppercase tracking-wide text-muted">Visibility</legend>

    <label class="flex items-center gap-2.5 text-sm text-fg">
      <input
        type="checkbox"
        name="published"
        checked={project ? project.published : true}
        class="h-4 w-4 accent-[var(--c-accent)]"
      />
      Published, visible on the public site
    </label>

    <label class="flex items-center gap-2.5 text-sm text-fg">
      <input
        type="checkbox"
        name="featured"
        checked={project?.featured ?? false}
        class="h-4 w-4 accent-[var(--c-accent)]"
      />
      Featured on the home page
    </label>

    <div class="max-w-40">
      <label for="sort_order" class={labelClass}>Sort order</label>
      <input
        id="sort_order"
        name="sort_order"
        type="number"
        step="1"
        value={project?.sort_order ?? 0}
        class={inputClass}
      />
      <p class={hintClass}>Higher shows first.</p>
    </div>
  </fieldset>

  <div class="flex flex-wrap items-center gap-3 border-t border-line pt-6">
    <button
      type="submit"
      class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-fg transition-colors hover:bg-accent-hover"
    >
      {submitLabel}
    </button>
    <a
      href="/admin"
      class="rounded-lg border border-line px-5 py-2.5 text-sm font-medium text-muted transition-colors hover:text-fg"
    >
      Cancel
    </a>
  </div>
</form>
