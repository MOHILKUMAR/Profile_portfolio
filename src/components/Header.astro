---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import { localizePath, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  activeNav?: 'work' | 'play' | null;
}

const { locale, activeNav = null } = Astro.props;
const t = useTranslations(locale);

const links = [
  { key: 'work' as const, label: t('nav.work'), href: localizePath('/projects', locale) },
  { key: 'play' as const, label: t('nav.play'), href: localizePath('/play', locale) },
  { key: null, label: t('nav.about'), href: `${localizePath('/', locale)}#about` },
  { key: null, label: t('nav.contact'), href: `${localizePath('/', locale)}#contact` },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a
      href={localizePath('/', locale)}
      class="flex items-center gap-2.5 text-base font-semibold tracking-tight text-fg hover:text-accent"
    >
      <Logo class="h-8 w-8 shrink-0" />
      <span>{t('site.title')}</span>
    </a>

    <nav aria-label={t('nav.menu')} class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={link.key && link.key === activeNav ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-surface-2',
              link.key && link.key === activeNav ? 'text-accent' : 'text-muted hover:text-fg',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitcher locale={locale} />
      <ThemeToggle locale={locale} />

      <details class="relative md:hidden" data-mobile-nav>
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-line text-muted hover:text-fg"
          aria-label={t('nav.menu')}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav
          aria-label={t('nav.menu')}
          class="absolute right-0 mt-2 w-48 rounded-lg border border-line bg-surface p-1 shadow-lg"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="block rounded-md px-3 py-2 text-sm font-medium text-fg hover:bg-surface-2"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close any open disclosure when clicking elsewhere or pressing Escape.
  const closeAll = (except?: EventTarget | null) => {
    document.querySelectorAll<HTMLDetailsElement>('details[data-mobile-nav], details[data-dropdown]').forEach((el) => {
      if (el !== except) el.open = false;
    });
  };

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const openDetails = target?.closest('details[data-mobile-nav], details[data-dropdown]');
    closeAll(openDetails);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });
</script>
