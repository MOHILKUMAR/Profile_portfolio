---
import Base from '../../layouts/Base.astro';
import ReactionGame from '../ReactionGame.astro';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base locale={locale} title={t('play.navLabel')} description={t('play.subtitle')} activeNav="play">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{t('play.title')}</h1>
      <p class="mt-3 text-lg leading-relaxed text-muted">{t('play.subtitle')}</p>
    </header>

    <ReactionGame locale={locale} />
  </div>
</Base>
