---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../ProjectCard.astro';
import { listPublishedProjects, localizeProject } from '../../lib/projects';
import { readEnv } from '../../lib/env';
import { localizePath, useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const featured = (await listPublishedProjects(Astro.locals, { featuredOnly: true, limit: 3 })).map((project) =>
  localizeProject(project, locale),
);

const fallback = featured.length
  ? []
  : (await listPublishedProjects(Astro.locals, { limit: 3 })).map((project) => localizeProject(project, locale));

const projects = featured.length ? featured : fallback;
const unavailable = Astro.locals.degraded;
const email = readEnv('PUBLIC_CONTACT_EMAIL');

const stack = ['TypeScript', 'Astro', 'React', 'Node', 'Postgres', 'Supabase', 'Vercel', 'Tailwind'];
---

<Base locale={locale}>
  <section class="mx-auto max-w-5xl px-4 pb-16 pt-16 sm:px-6 sm:pt-24">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-muted"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-positive" aria-hidden="true"></span>
      {t('hero.eyebrow')}
    </p>

    <h1 class="mt-6 max-w-3xl text-4xl font-bold leading-[1.1] tracking-tight text-fg sm:text-6xl">
      {t('hero.title')}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{t('hero.body')}</p>

    <div class="mt-9 flex flex-wrap gap-3">
      <a
        href={localizePath('/projects', locale)}
        class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-fg transition-colors hover:bg-accent-hover"
      >
        {t('hero.ctaWork')}
      </a>
      <a
        href="#contact"
        class="rounded-lg border border-line px-5 py-2.5 text-sm font-semibold text-fg transition-colors hover:bg-surface-2"
      >
        {t('hero.ctaContact')}
      </a>
    </div>
  </section>

  <section id="about" class="border-t border-line bg-surface scroll-mt-16">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-[1fr_1.4fr]">
      <h2 class="text-2xl font-semibold tracking-tight text-fg">{t('about.title')}</h2>
      <div class="space-y-4">
        <p class="text-base leading-relaxed text-muted">{t('about.body1')}</p>
        <p class="text-base leading-relaxed text-muted">{t('about.body2')}</p>

        <div class="pt-3">
          <p class="text-xs font-medium uppercase tracking-wide text-muted">{t('about.stackLabel')}</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              stack.map((item) => (
                <li class="rounded-md border border-line bg-bg px-2.5 py-1 text-sm text-fg">{item}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-fg">{t('work.featuredTitle')}</h2>
        <p class="mt-2 text-muted">{t('work.subtitle')}</p>
      </div>
      <a
        href={localizePath('/projects', locale)}
        class="hidden shrink-0 text-sm font-medium text-accent underline-offset-4 hover:underline sm:block"
      >
        {t('work.viewAll')}
      </a>
    </div>

    {
      projects.length > 0 ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard project={project} locale={locale} />
          ))}
        </div>
      ) : (
        <p class="mt-8 rounded-xl border border-dashed border-line bg-surface p-8 text-center text-muted">
          {unavailable ? t('work.unavailable') : t('work.empty')}
        </p>
      )
    }

    <a
      href={localizePath('/projects', locale)}
      class="mt-6 inline-block text-sm font-medium text-accent underline-offset-4 hover:underline sm:hidden"
    >
      {t('work.viewAll')}
    </a>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-4 py-16 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <h2 class="text-2xl font-semibold tracking-tight text-fg">{t('play.title')}</h2>
        <p class="mt-2 leading-relaxed text-muted">{t('play.subtitle')}</p>
      </div>
      <a
        href={localizePath('/play', locale)}
        class="shrink-0 rounded-lg border border-accent px-5 py-2.5 text-sm font-semibold text-accent transition-colors hover:bg-accent hover:text-accent-fg"
      >
        {t('play.navLabel')}
      </a>
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-5xl scroll-mt-16 px-4 py-16 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight text-fg">{t('contact.title')}</h2>
    <p class="mt-3 max-w-xl leading-relaxed text-muted">{t('contact.body')}</p>
    {
      email && (
        <a
          href={`mailto:${email}`}
          class="mt-6 inline-block text-xl font-semibold text-accent underline-offset-4 hover:underline sm:text-2xl"
        >
          {email}
        </a>
      )
    }
  </section>
</Base>
