---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../ProjectCard.astro';
import { listPublishedProjects, localizeProject } from '../../lib/projects';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = (await listPublishedProjects(Astro.locals)).map((project) => localizeProject(project, locale));
const unavailable = Astro.locals.degraded;
---

<Base locale={locale} title={t('work.title')} activeNav="work">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <header class="max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{t('work.title')}</h1>
      <p class="mt-3 text-lg leading-relaxed text-muted">{t('work.subtitle')}</p>
      {
        projects.length > 0 && (
          <p class="mt-2 text-sm text-muted">{t('work.count', { count: projects.length })}</p>
        )
      }
    </header>

    {
      projects.length > 0 ? (
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard project={project} locale={locale} />
          ))}
        </div>
      ) : (
        <p class="mt-10 rounded-xl border border-dashed border-line bg-surface p-10 text-center text-muted">
          {unavailable ? t('work.unavailable') : t('work.empty')}
        </p>
      )
    }
  </div>
</Base>
