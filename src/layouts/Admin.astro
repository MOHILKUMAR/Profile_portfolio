---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  /** Login and callback screens render without the signed-in chrome. */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Admin</title>
    <Font cssVariable="--font-outfit" preload />
    {/* Required, not optional: --font-sans references this variable, and one
        undefined var() voids the whole font list, dropping Outfit too. It only
        downloads when Devanagari appears, e.g. in the Hindi translation fields. */}
    <Font cssVariable="--font-devanagari" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (err) {
          /* Storage blocked, fall back to the system preference. */
        }
      })();
    </script>
  </head>

  <body class="min-h-dvh bg-bg text-fg antialiased">
    {
      !bare && (
        <header class="border-b border-line bg-surface">
          <div class="mx-auto flex h-14 max-w-4xl items-center justify-between gap-4 px-4 sm:px-6">
            <a href="/admin" class="flex items-center gap-2 text-sm font-semibold tracking-tight">
              <Logo class="h-6 w-6" />
              Admin
            </a>
            <div class="flex items-center gap-4">
              <a href="/" class="text-sm text-muted underline-offset-4 hover:text-accent hover:underline">
                View site
              </a>
              {user?.email && <span class="hidden text-sm text-muted sm:inline">{user.email}</span>}
              <form method="post" action="/api/admin/logout">
                <button
                  type="submit"
                  class="rounded-md border border-line px-3 py-1.5 text-sm font-medium text-muted transition-colors hover:text-fg"
                >
                  Sign out
                </button>
              </form>
            </div>
          </div>
        </header>
      )
    }

    <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
      <slot />
    </main>
  </body>
</html>
