{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-09-21",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// Every value here is safe to publish. The Supabase anon key is meant to be
	// public: row level security is what actually protects the data. Fill these
	// in before deploying, or set them under Workers > Settings > Variables.
	"vars": {
		"PUBLIC_SUPABASE_URL": "",
		"PUBLIC_SUPABASE_ANON_KEY": "",
		"PUBLIC_SITE_URL": "",
		"PUBLIC_OG_IMAGE": "",
		"PUBLIC_CONTACT_EMAIL": "",
		"PUBLIC_GITHUB_URL": "",
		"PUBLIC_LINKEDIN_URL": ""
	}
}
